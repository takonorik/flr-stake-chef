{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/japanese-guard/japanese-guard.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/japanese-guard/japanese-guard.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ]
  }
}
